# ANT.G-2.8.2 - NVIDIA build configuration

#
# Important flags for ANT Make file 
#

# Preprocessor flags. Must be the same value as in Gaussian
PREPROC= -DDEFMAXSHL=250000 -DDEFMAXATM=250000 -DDEFMAXTIT=100 -DDEFMAXRTE=4000

# Compilation flags.
CFLAGS= -Bstatic_pgi -i8 -r8 '-mcmodel=medium' -mp=nonuma -tp x86-64-v3 -Mreentrant -Mrecursive -Mnosave -Minfo -Mneginfo -time -fast -O2 -Munroll -Mvect=assoc,recog,cachesize:1572864

# Extra libs from Gaussian needed for compiling/linking ANT
GAUSSLIBS= /home/palacios/Gaussian/Gaussian09/Rev.D01/nvidia/g09/util.a /home/palacios/Gaussian/Gaussian09/Rev.D01/nvidia/g09/bsd/libf77blas-amd64.a /home/palacios/Gaussian/Gaussian09/Rev.D01/nvidia/g09/bsd/libatlas-amd64.a

# Linking flags
LFLAGS= -Bstatic_pgi -lpthread -lm -lc

# BLAS/LAPACK used by ANT (module lapack_blas):
#   nvhpc   - optimized OpenBLAS of the NVIDIA HPC SDK (64-bit integers, liblapack_ilp64 and
#             libblas_ilp64), linked under symbols renamed to antnv_* so that they do not
#             replace Gaussian's own BLAS/LAPACK in l502.exe (needs nm and objcopy)
#   bundled - the reference routines of lapack_blas.f
ANTLAPACK = nvhpc
# Library directory of the NVIDIA HPC SDK (next to the bin directory of the compiler)
NVHPCLIB = $(abspath $(dir $(shell which $(F90)))../lib)
