# ANT.G-3.1.0 - Intel build configuration

#
# Important flags for ANT Make file 
#

# Preprocessor flags. Must be the same value as in Gaussian
PREPROC= -DDEFMAXSHL=250000 -DDEFMAXATM=250000 -DDEFMAXTIT=100 -DDEFMAXRTE=4000

# Compilation flags.
CFLAGS= -i8 -r8 -auto -axAVX -fp-speculation=safe -static-intel -static-libgcc -no-prec-div -fpp -ftz -pad -qmkl -qopenmp -O2 -unroll

# Extra libs from Gaussian needed for compiling/linking ANT
GAUSSLIBS= /home/palacios/Gaussian/Gaussian09/Rev.D01/intel/g09/util.a

# Linking flags
LFLAGS= -lpthread
