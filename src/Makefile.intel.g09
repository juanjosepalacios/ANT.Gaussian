# set complier/linker and options
MAKE=make
F90=ifx
CC=icx
AR=ar
BIN=../bin

# MKL related libs
MKLROOT= /opt/intel/oneapi/mkl/2024.0
MKLPATH= ${MKLROOT}/lib
MKLINCLUDE=${MKLROOT}/include
INTELLIBS= -Wl,--start-group ${MKLPATH}/libmkl_intel_ilp64.a ${MKLPATH}/libmkl_core.a ${MKLPATH}/libmkl_intel_thread.a -Wl,--end-group

# Gaussian 09 must be built with -fp-speculation=safe added to RUNF77 in bsd/i386.make. With
# ifx's default -fp-speculation=fast, the dlaed4 and dlasd4 that Gaussian bundles in util.a fail,
# so DSYEVD ("DSYEVD-2 returned Info=...", then NaN for symmetry blocks) and DGESDD ("GSVD:
# received Info=1 from GESDD", then "Error in orthogonal basis" in l302) fail in every link.
# MKL's DSYEVD object is linked ahead of util.a, which protects l502.exe on a Gaussian built
# without the flag.
MKLDSYEVD=../obj/mkl_dsyevd.o

include make.in

# use these sources: 
SRCS= preproc.F constants.f90 messages.f90 util.f90 g09Common.f90 parameters.f90 antcommon.f90 numeric.f90 filemaster.f90 cluster.f90 ortho.f90 correlation.f90 OneDLead.f90 BetheLattice.f90 SpinOrbit.f90 SpinRotate.f90 MolMod.f90 Zeeman.f90 device.f90 ANT.f90

# use name of parent directory as library name
PARDIRNAME=$(shell dirname `pwd`)
LIBNAME=$(shell basename $(PARDIRNAME))

# objects
OBJS= $(SRCS:%.c=../obj/%.o) $(SRCS:%.f=../obj/%.o) $(SRCS:%.F=../obj/%.o) $(SRCS:%.f90=../obj/%.o) 

# ANT.G library to be generated
ANTLIB=../lib/$(LIBNAME).a
L502=$(BIN)/l502.exe 

# prepocessing 
%.f90: %.F90
	gau-cpp -DG09ROOT -DINTEL $< $@

# rule for object generation
../obj/%.o: %.c 
	$(CC) -c -o $@ $<
../obj/%.o: %.F
	$(F90) $(CFLAGS) -I$(MKLINCLUDE) $(PREPROC) -c -o $@ $<
../obj/%.o: %.f 
	$(F90) $(CFLAGS) -I$(MKLINCLUDE) -c -o $@ $<
../obj/%.o: %.f90 
	$(F90) $(CFLAGS) -I$(MKLINCLUDE) -c -o $@ $<

# targets: libraries and l502.exe
target: $(ANTLIB) $(L502) 

# rule for the library
$(ANTLIB): $(OBJS)
	echo $(OBJS)
	- rm  $(ANTLIB)
	$(AR) crv $(ANTLIB) $(OBJS)

# MKL's DSYEVD, extracted from the ILP64 interface library
$(MKLDSYEVD):
	cd ../obj && ar x $(MKLPATH)/libmkl_intel_ilp64.a _dsyevd.o && mv _dsyevd.o mkl_dsyevd.o

# rule for l502.exe
$(L502): $(OBJS) $(MKLDSYEVD)
	$(F90) $(CFLAGS) -o $(L502) $(BIN)/ml502.o $(BIN)/l502.a $(BIN)/bdam1.o $(BIN)/caldsu.o $(MKLDSYEVD) -L$(MKLPATH) $(GAUSSLIBS) $(ANTLIB) $(INTELLIBS) $(LFLAGS) 

	chmod o-rwx $(L502)

# Cleaning up to compile from scratch afterwards
clean:
	@echo "Cleaning up..."
	-rm ./*.mod
	-rm ./*.f90
	-rm $(BIN)/l502.exe
	-rm ../obj/*.o
	-rm ../lib/*.a
