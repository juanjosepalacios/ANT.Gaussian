module model
 use, intrinsic :: ieee_arithmetic
 implicit none
 integer :: NCDAO1=1,NCDAO2=4,calls=0
 real*8 :: EMin=-123d0,EMax=14567d0
 character(len=32) :: mode
contains
@CHECK@
 real*8 function TotCharge(e,lower_bound,integration_status) result(q)
 real*8,intent(in) :: e,lower_bound
 integer,intent(out) :: integration_status
 calls=calls+1
 if(calls==1) then
  if(e/=1000d0.or.lower_bound/=-1000d0)stop 10
 else if(calls==2)then
  if(e/=10000d0.or.lower_bound/=-10000d0)stop 11
 else
  stop 12
 endif
 integration_status=0;q=8d0
 if(calls==1)then
  if(mode=='retry'.or.mode=='failure')q=7d0
  if(mode=='excess')q=9d0
  if(mode=='quadrature')integration_status=1
  if(mode=='nonfinite')q=ieee_value(q,ieee_quiet_nan)
 endif
 if(mode=='failure')q=7d0
 end function
end module
program test
 use model
 implicit none
 logical :: bounds
 call get_command_argument(1,mode)
 call CheckEnergyBounds(bounds)
 if(.not.bounds)stop 20
 if(mode=='first'.and.calls/=1)stop 21
 if(mode/='first'.and.calls/=2)stop 22
 if(EMin/=-123d0.or.EMax/=14567d0)stop 23
end program
