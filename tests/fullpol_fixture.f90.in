module fullpol_mod
 implicit none
contains
@DEVICE@
end module

program test_fullpol
 use fullpol_mod
 implicit none
 integer,parameter :: n=4, nn=2*n
 complex*16,parameter :: ci=(0d0,1d0), c0=(0d0,0d0), c1=(1d0,0d0)
 complex*16,dimension(nn,nn) :: H,S,SigL,SigR,GL,GR,G,X,sx,sy,sz,U,M,Id
 complex*16,dimension(nn,nn) :: GLr,GRr,Hr
 real*8 :: T,P(3),Tref,Pref(3),T2,P2(3),Rm(3,3),tol,E,nv(3),th,polar
 integer :: i,a,fails
 fails=0
 tol=1d-10

 ! sign convention: GammaR = 1 and X = (1 + sigma_a)/2 must give T = 1, P = unit vector a
 call pauli(sx,sy,sz)
 Id=c0
 do i=1,nn
  Id(i,i)=c1
 end do
 do a=1,3
  if(a==1) X=(Id+sx)/2
  if(a==2) X=(Id+sy)/2
  if(a==3) X=(Id+sz)/2
  call FullPolTraces(n,Id,X,T,P)
  Pref=0d0;Pref(a)=1d0
  call check('unit spinor along axis',abs(T-n)+sum(abs(P-n*Pref)),fails,tol)
 end do

 ! random SOC device, non-orthogonal S = diag(S0,S0), spin-split (magnetic) leads
 E=0.3d0
 call device(H,S,1d0)
 call leads(SigL,SigR,.true.)
 call green(E,H,S,SigL,SigR,G,GL,GR)
 X=matmul(matmul(G,GL),conjg(transpose(G)))
 call FullPolTraces(n,GR,X,T,P)
 ! dense reference with explicit sigma_a x 1
 M=matmul(GR,X)
 Tref=dble(trace(M))
 Pref(1)=dble(trace(matmul(sx,M)))
 Pref(2)=dble(trace(matmul(sy,M)))
 Pref(3)=dble(trace(matmul(sz,M)))
 call check('dense Re Tr[sigma_a GammaR G GammaL G^+]',abs(T-Tref)+sum(abs(P-Pref)),fails,tol*max(1d0,Tref))
 ! the T ANT already computes, Tr[GammaL G^a GammaR G^r]
 T2=dble(trace(matmul(matmul(matmul(GL,conjg(transpose(G))),GR),G)))
 call check('T equals the existing Caroli trace',abs(T-T2),fails,tol*max(1d0,T2))
 ! Pz equals the existing POL (T_uu + T_du - T_dd - T_ud) for spin-block-diagonal Gamma
 polar=pol(G,GL,GR)
 call check('Pz equals POL',abs(P(3)-polar),fails,tol*max(1d0,T))
 if(T<1d-3) call check('non-trivial transmission',1d0,fails,tol)

 ! non-magnetic leads: a global spin rotation of H rotates P as a vector, and |P| <= T
 call device(H,S,1d0)
 call leads(SigL,SigR,.false.)
 call green(E,H,S,SigL,SigR,G,GL,GR)
 X=matmul(matmul(G,GL),conjg(transpose(G)))
 call FullPolTraces(n,GR,X,T,P)
 call check('|P| <= T',max(0d0,sqrt(sum(P**2))-T),fails,tol)
 call check('spin-mixing device gives a non-zero P',merge(1d0,0d0,sqrt(sum(P**2))<1d-6),fails,tol)
 nv=(/1d0,2d0,-0.5d0/);nv=nv/sqrt(sum(nv**2));th=0.7d0
 U=cos(th/2)*Id-ci*sin(th/2)*(nv(1)*sx+nv(2)*sy+nv(3)*sz)
 Hr=matmul(matmul(U,H),conjg(transpose(U)))
 call green(E,Hr,S,SigL,SigR,G,GLr,GRr)
 X=matmul(matmul(G,GLr),conjg(transpose(G)))
 call FullPolTraces(n,GRr,X,T2,P2)
 call rotmat(nv,th,Rm)
 call check('global spin rotation: T invariant, P -> R P',abs(T2-T)+sum(abs(P2-matmul(Rm,P))),fails,tol*max(1d0,T))

 if(fails>0) then
  print *,'ERROR: ',fails,' FULLPOL checks failed'
  stop 1
 end if
 print *,'All FULLPOL checks passed'

contains

 subroutine check(name,err,fails,tol)
  character(*),intent(in) :: name
  real*8,intent(in) :: err,tol
  integer,intent(inout) :: fails
  if(err>tol .or. err/=err) then
   print *,'FAIL: ',name,err
   fails=fails+1
  else
   print *,'PASS: ',name,err
  end if
 end subroutine

 complex*16 function trace(A)
  complex*16,intent(in) :: A(:,:)
  integer :: i
  trace=c0
  do i=1,size(A,1)
   trace=trace+A(i,i)
  end do
 end function

 subroutine pauli(sx,sy,sz)
  complex*16,intent(out),dimension(nn,nn) :: sx,sy,sz
  integer :: i
  sx=c0;sy=c0;sz=c0
  do i=1,n
   sx(i,i+n)=c1;   sx(i+n,i)=c1
   sy(i,i+n)=-ci;  sy(i+n,i)=ci
   sz(i,i)=c1;     sz(i+n,i+n)=-c1
  end do
 end subroutine

 ! deterministic pseudo-random numbers in [-1,1]
 real*8 function rnd(k)
  integer,intent(in) :: k
  rnd=sin(12.9898d0*k+78.233d0*mod(k*k,97))
 end function

 ! Hermitian spinor H with spin-mixing (SOC-like) blocks; S = diag(S0,S0), S0 real SPD
 subroutine device(H,S,lam)
  complex*16,intent(out),dimension(nn,nn) :: H,S
  real*8,intent(in) :: lam
  complex*16 :: A(nn,nn)
  integer :: i,j
  do j=1,nn
   do i=1,nn
    A(i,j)=dcmplx(rnd(i+nn*j),rnd(3*i+7*nn*j+5))
   end do
  end do
  do j=1,n
   do i=1,n
    A(i,j+n)=lam*A(i,j+n)
    A(i+n,j)=lam*A(i+n,j)
   end do
  end do
  H=(A+conjg(transpose(A)))/2
  S=c0
  do j=1,n
   do i=1,n
    S(i,j)=dcmplx(0.1d0*(rnd(11*i+13*j)+rnd(13*i+11*j)),0d0)
   end do
   S(j,j)=c1
  end do
  S(n+1:nn,n+1:nn)=S(1:n,1:n)
 end subroutine

 ! spin-block-diagonal lead self-energies with negative-definite imaginary parts,
 ! coupled to orbital 1 (left) and orbitals n-1, n (right) of each spin
 subroutine leads(SigL,SigR,magnetic)
  complex*16,intent(out),dimension(nn,nn) :: SigL,SigR
  logical,intent(in) :: magnetic
  real*8 :: f
  integer :: s
  SigL=c0;SigR=c0
  do s=0,1
   f=1d0
   if(magnetic .and. s==1) f=0.4d0
   SigL(1+s*n,1+s*n)=dcmplx(-0.2d0,-0.8d0*f)
   SigR(n-1+s*n,n-1+s*n)=dcmplx(0.1d0,-0.5d0*f)
   SigR(n+s*n,n+s*n)=dcmplx(-0.1d0,-0.7d0*f)
   SigR(n-1+s*n,n+s*n)=dcmplx(0.05d0,-0.3d0*f)
   SigR(n+s*n,n-1+s*n)=dcmplx(0.05d0,-0.3d0*f)
  end do
 end subroutine

 subroutine green(E,H,S,SigL,SigR,G,GL,GR)
  real*8,intent(in) :: E
  complex*16,intent(in),dimension(nn,nn) :: H,S,SigL,SigR
  complex*16,intent(out),dimension(nn,nn) :: G,GL,GR
  G=E*S-H-SigL-SigR
  call invert(G)
  GL=ci*(SigL-conjg(transpose(SigL)))
  GR=ci*(SigR-conjg(transpose(SigR)))
 end subroutine

 ! Gauss-Jordan inversion with partial pivoting
 subroutine invert(A)
  complex*16,intent(inout) :: A(nn,nn)
  complex*16 :: B(nn,2*nn),row(2*nn),piv
  integer :: i,k,p
  B=c0;B(:,1:nn)=A
  do i=1,nn
   B(i,nn+i)=c1
  end do
  do k=1,nn
   p=k-1+maxloc(abs(B(k:nn,k)),1)
   row=B(k,:);B(k,:)=B(p,:);B(p,:)=row
   piv=B(k,k);B(k,:)=B(k,:)/piv
   do i=1,nn
    if(i/=k) B(i,:)=B(i,:)-B(i,k)*B(k,:)
   end do
  end do
  A=B(:,nn+1:2*nn)
 end subroutine

 ! existing POL algebra of device.F90::transmission, on n x n spin blocks
 real*8 function pol(G,GL,GR)
  complex*16,intent(in),dimension(nn,nn) :: G,GL,GR
  complex*16,dimension(nn,nn) :: Gd
  complex*16 :: tuu,tud,tdu,tdd
  integer :: u1,u2,d1,d2
  u1=1;u2=n;d1=n+1;d2=nn
  Gd=conjg(transpose(G))
  tuu=trace(matmul(matmul(matmul(GL(u1:u2,u1:u2),Gd(u1:u2,u1:u2)),GR(u1:u2,u1:u2)),G(u1:u2,u1:u2)))
  tud=trace(matmul(matmul(matmul(GL(u1:u2,u1:u2),Gd(u1:u2,d1:d2)),GR(d1:d2,d1:d2)),G(d1:d2,u1:u2)))
  tdu=trace(matmul(matmul(matmul(GL(d1:d2,d1:d2),Gd(d1:d2,u1:u2)),GR(u1:u2,u1:u2)),G(u1:u2,d1:d2)))
  tdd=trace(matmul(matmul(matmul(GL(d1:d2,d1:d2),Gd(d1:d2,d1:d2)),GR(d1:d2,d1:d2)),G(d1:d2,d1:d2)))
  pol=dble(tuu+tdu-tdd-tud)
 end function

 ! SO(3) rotation matching U = exp(-i th n.sigma/2): U sigma_b U^+ = sum_a R(b,a) sigma_a ... applied as P -> R P
 subroutine rotmat(nv,th,R)
  real*8,intent(in) :: nv(3),th
  real*8,intent(out) :: R(3,3)
  real*8 :: c,s,K(3,3)
  integer :: i
  c=cos(th);s=sin(th)
  K=0d0
  K(1,2)=-nv(3);K(1,3)=nv(2)
  K(2,1)=nv(3); K(2,3)=-nv(1)
  K(3,1)=-nv(2);K(3,2)=nv(1)
  R=s*K+(1-c)*matmul(K,K)
  do i=1,3
   R(i,i)=R(i,i)+1d0
  end do
 end subroutine

end program
