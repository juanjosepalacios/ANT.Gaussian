module numeric
 implicit none
 integer :: test_bracket_calls=0
 real*8 :: test_centers(32)=0d0
 contains
@BRACKET@
@BRENT@
end module
module parameters
 integer,parameter :: Max=100
 real*8 :: FermiAcc=1d-8
end module
module test_leads
 use parameters
 implicit none
 integer,parameter :: double=kind(1d0)
 type T1DLead
 integer :: LeadNo,NPCEl
 real*8 :: EMin=-100d0,EMax=100d0,EFermi=0d0
 end type
 type(T1DLead) :: Lead1D(2)
 integer :: WhichLead=1,FermiEvaluations=0
 real*8 :: ChargeOffset=0d0
 real*8 :: model_roots(2)=(/-7d0,3d0/),targets(2)=(/7d0,11d0/)
 real*8 :: slopes(2)=(/2d0,0.5d0/)
@HISTORY@
 contains
 real*8 function TotCharge(E)
 real*8,intent(in)::E
 TotCharge=targets(WhichLead)+slopes(WhichLead)*(E-model_roots(WhichLead))-ChargeOffset
 end function
@COUNTED@
@FIND@
end module
module bracket_models
 use,intrinsic :: ieee_arithmetic,only:ieee_value,ieee_quiet_nan
 implicit none
 integer :: calls=0,mode=1
 real*8 :: target=85d0
 contains
 real*8 function f(x)
 real*8,intent(in)::x
 calls=calls+1
 f=x-target
 if(mode==2) f=x*x+1d0
 if(mode==3) f=ieee_value(0d0,ieee_quiet_nan)
 end function
end module
program regression
 use test_leads
 use numeric
 use bracket_models
 implicit none
 real*8 :: a,b,fa,fb,x,residual,width
 integer :: expand,nev,status,it
 Lead1D(1)%LeadNo=1;Lead1D(2)%LeadNo=2
 Lead1D(1)%NPCEl=7;Lead1D(2)%NPCEl=11
 call FindFermi(Lead1D(1))
 if(abs(Lead1D(1)%EFermi+7d0)>FermiAcc) stop 10
 if(WarmLeadFermiValid(2)) stop 11
 call FindFermi(Lead1D(2))
 if(abs(Lead1D(2)%EFermi-3d0)>FermiAcc) stop 12
 if(test_bracket_calls/=0) stop 13
 if(any(abs(WarmLeadFermi-model_roots)>FermiAcc)) stop 14
 ! Different updates, reverse call order, and altered public EFermi fields:
 ! warm guesses must remain independent and in the unshifted reference.
 Lead1D(1)%EFermi=0d0;Lead1D(2)%EFermi=0d0
 model_roots=(/-6.97d0,3.08d0/)
 call FindFermi(Lead1D(2))
 call FindFermi(Lead1D(1))
 if(test_bracket_calls/=2) stop 15
 if(abs(test_centers(1)-3d0)>FermiAcc) stop 16
 if(abs(test_centers(2)+7d0)>FermiAcc) stop 17
 if(any(abs(WarmLeadFermi-model_roots)>FermiAcc)) stop 18
 ! A large change in lead 1 must expand, while preserving lead 2 history.
 model_roots(1)=85d0
 call FindFermi(Lead1D(1))
 if(abs(Lead1D(1)%EFermi-85d0)>FermiAcc) stop 19
 if(abs(WarmLeadFermi(2)-3.08d0)>FermiAcc) stop 20
 ! Exercise saturation to the full interval and avoid duplicate root endpoints.
 calls=0;target=85d0;mode=1
 call BracketRoot(f,0d0,-100d0,100d0,0.25d0,a,b,fa,fb,expand,nev,status)
 if(status/=0.or.a/=-100d0.or.b/=100d0.or.expand<1.or.nev/=calls) stop 21
 calls=0
 x=BrentRoot(f,a,b,1d-8,100,it,nev,status,residual,width,fa,fb)
 if(status/=0.or.abs(x-85d0)>1d-8.or.nev/=calls.or.nev/=1) stop 22
 ! A guess outside the new domain must be clamped and expand safely.
 calls=0;target=0.9d0
 call BracketRoot(f,-50d0,0d0,1d0,0.25d0,a,b,fa,fb,expand,nev,status)
 if(status/=0.or.a/=0d0.or.b/=1d0) stop 23
 ! The fixed endpoint x=0 is evaluated once, not once per expansion.
 if(nev/=4.or.calls/=4) stop 24
 mode=2
 call BracketRoot(f,0d0,-1d0,1d0,0.25d0,a,b,fa,fb,expand,nev,status)
 if(status/=1) stop 25
 mode=3
 call BracketRoot(f,0d0,-1d0,1d0,0.25d0,a,b,fa,fb,expand,nev,status)
 if(status/=4) stop 26
 mode=1
 call BracketRoot(f,0d0,-1d0,1d0,0d0,a,b,fa,fb,expand,nev,status)
 if(status/=3.or.nev/=0) stop 27
 print *, 'PASS: distinct leads keep independent histories and electron targets'
 print *, 'PASS: reversed SCF order, unshifted guesses, large shifts and full-interval fallback'
 print *, 'PASS: current endpoint reuse, changed bounds, invalid bracket/input and nonfinite values'
end program
