module parameters
 real*8 :: FermiAcc=1d-8,ChargeAcc=1d-8,QExcess=0d0,FermiStart=0.7d0
 real*8 :: EFMax=huge(1d0)
 logical :: QScan=.false.
 integer :: Max=40
 logical :: FixEFermi=.false.,DevMuller=.false.
end module
module numeric
contains
@NUMERIC@
end module
module model
 use parameters
 use, intrinsic :: ieee_arithmetic
 implicit none
 integer :: ifu_log=6,NCDEl=10,NSpin=1,ispin=1,mode=0
 real*8 :: EMin=-10d0,EMax=10d0,shift=2d0,shiftup=1d0,shiftdown=-1d0
 real*8 :: QAlpha,QBeta,Q_SOC,density(2)=0d0,last=0d0,FermiSteps(4,2)=-1d0
 logical :: SPINLOCK=.false.
contains
@DEVICE@
 real*8 function QTot(x) result(q)
 real*8,intent(in) :: x
 shift=x;last=x;density=x
 q=x*x*x-0.064d0
 if(mode==1) q=1d0
 if(mode==2) q=ieee_value(x,ieee_quiet_nan)
 if(mode==3) then
  q=-1d0
  if(x>0.123456789123d0) q=1d0
 endif
 QAlpha=(NCDEl+q)/2d0;QBeta=QAlpha
 end function
 real*8 function QTot_SPINLOCK(x) result(q)
 real*8,intent(in) :: x
 shift=x;last=x;density(ispin)=x
 if(ispin==1) then
 q=x-0.2d0;QAlpha=5d0+q
 else
 q=x+0.3d0;QBeta=5d0+q
 endif
 end function
 real*8 function QTot_SOC(x) result(q)
 real*8,intent(in) :: x
 q=QTot(x);Q_SOC=QAlpha+QBeta
 end function
 real*8 function CompPD(x) result(q)
 real*8,intent(in) :: x
 q=QTot(x)
 end function
 real*8 function CompSpinPD(x) result(q)
 real*8,intent(in) :: x
 q=QTot_SPINLOCK(x)
 end function
 real*8 function CompPD_SOC(x) result(q)
 real*8,intent(in) :: x
 q=QTot_SOC(x)
 end function
end module
program test
 use model
 implicit none
 logical :: ok
 character(len=32) :: arg
 call get_command_argument(1,arg)
 if(arg=='no-bracket')mode=1
 if(arg=='nonfinite')mode=2
 if(arg=='charge-failure')mode=3
 ! E_F<=-0.5 excludes the root at shift=0.4
 if(arg=='efmax')EFMax=-0.5d0
 if(arg=='qscan')then;mode=3;QScan=.true.;end if
 call CompDensMat(ok)
 if(.not.ok.or.abs(shift-0.4d0)>FermiAcc.or.last/=shift)stop 10
 call CompDensMat_SOC(ok)
 if(.not.ok.or.abs(shift-0.4d0)>FermiAcc.or.last/=shift)stop 11
 call CompDensMat2(ok)
 if(.not.ok.or.abs(shift-0.4d0)>FermiAcc.or.last/=shift)stop 12
 call CompDensMat2_SOC(ok)
 if(.not.ok.or.abs(shift-0.4d0)>FermiAcc.or.last/=shift)stop 13
 NSpin=2;SPINLOCK=.true.
 call CompDensMat(ok)
 if(.not.ok.or.abs(shiftup-0.2d0)>FermiAcc.or.abs(shiftdown+0.3d0)>FermiAcc)stop 14
 if(density(1)/=shiftup.or.density(2)/=shiftdown)stop 15
 shiftup=1d0;shiftdown=-1d0
 call CompDensMat2(ok)
 if(.not.ok.or.abs(shiftup-0.2d0)>FermiAcc.or.abs(shiftdown+0.3d0)>FermiAcc)stop 16
 FixEFermi=.true.
 call CompDensMat(ok)
 if(.not.ok.or.shiftup/=-FermiStart.or.shiftdown/=-FermiStart)stop 17
 SPINLOCK=.false.
 call CompDensMat(ok)
 if(.not.ok.or.shift/=-FermiStart.or.last/=shift)stop 18
 call CompDensMat_SOC(ok)
 if(.not.ok.or.shift/=-FermiStart.or.last/=shift)stop 19
 print *, 'PASS: device Brent, final density state, spin branches, SOC and fixed Fermi'
 FixEFermi=.false.;DevMuller=.true.;shift=2d0
 call CompDensMat(ok)
 if(.not.ok.or.abs(shift-0.4d0)>1d-6.or.last/=shift)stop 20
 SPINLOCK=.true.;shiftup=1d0;shiftdown=-1d0
 call CompDensMat(ok)
 if(.not.ok.or.abs(shiftup-0.2d0)>1d-6.or.abs(shiftdown+0.3d0)>1d-6)stop 21
 if(density(1)/=shiftup.or.density(2)/=shiftdown)stop 22
 print *, 'PASS: DEVMULLER collinear and spin-locked searches'
 SPINLOCK=.false.;EFMax=1d0
 DevMuller=.false.;shift=2d0
 call CompDensMat(ok)
 if(.not.ok.or.abs(shift-0.4d0)>FermiAcc.or.last/=shift)stop 23
 DevMuller=.true.;shift=2d0
 call CompDensMat(ok)
 if(.not.ok.or.abs(shift-0.4d0)>1d-6.or.last/=shift)stop 24
 print *, 'PASS: EFMAX above the root leaves Brent and DEVMULLER unchanged'
end program
