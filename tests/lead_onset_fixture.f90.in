module numeric
contains
@SEARCH@
end module
module parameters
 integer :: Max=15
 real*8 :: ChargeAcc=1d-2,FermiAcc=1d-5,Infty=10000d0
end module
module leads
 use parameters
 implicit none
 type T1DLead
 integer :: LeadNo
 real*8 :: EMin
 end type
 real*8 :: WarmLeadLower(2)=0d0,WarmLeadLowerUpper(2)=0d0
 logical :: WarmLeadLowerValid(2)=.false.
 real*8 :: ChargeOffset=0d0,edges(2)=(/-2d0,3d0/),amp(2)=(/0.2d0,0.5d0/)
 integer :: WhichLead=1,mode=0,seen=0
 contains
 real*8 function TotCharge(e,accuracy,error_estimate,status)
 intrinsic :: max
 real*8,intent(in) :: e
 real*8,intent(in),optional :: accuracy
 real*8,intent(out),optional :: error_estimate
 integer,intent(out),optional :: status
 if(.not.present(accuracy).or..not.present(error_estimate).or..not.present(status)) stop 90
 if(abs(accuracy-ChargeAcc)>1d-15) stop 91
 seen=seen+1
 status=0
 error_estimate=accuracy/2d0
 TotCharge=amp(WhichLead)/(1d0+max(0d0,edges(WhichLead)-e))
 if(mode==1) then
  if(e>-30d0) status=2
 endif
 end function
@WRAPPER@
end module
program test
 use leads
 use numeric
 use, intrinsic :: ieee_arithmetic
 implicit none
 type(T1DLead) :: a,b
 real*8 :: exact,oldlo,lo,hi,q,err,seed
 integer :: calls,status
 a%LeadNo=1;a%EMin=-27d0
 b%LeadNo=2;b%EMin=-22d0
 call FindLowerChargeBound(a)
 exact=edges(1)+1d0-amp(1)/ChargeAcc
 if(a%EMin>exact.or.exact-a%EMin>2d0+1d-8) stop 10
 oldlo=a%EMin
 seen=0
 call FindLowerChargeBound(a)
 if(seen/=1) stop 24
 call FindLowerChargeBound(b)
 if(a%EMin/=oldlo.or..not.all(WarmLeadLowerValid)) stop 11
 exact=edges(2)+1d0-amp(2)/ChargeAcc
 if(b%EMin>exact.or.exact-b%EMin>2d0+1d-8) stop 12
 ! Re-evaluate changed Hamiltonians, in reverse order, without sharing charges.
 edges(2)=4d0;edges(1)=-4d0;ChargeAcc=5d-3
 call FindLowerChargeBound(b)
 call FindLowerChargeBound(a)
 exact=edges(1)+1d0-amp(1)/ChargeAcc
 if(a%EMin>exact.or.exact-a%EMin>2d0+1d-8) stop 13
 print *, 'PASS: algebraic tails, coarse conservative endpoints, independent warm histories and changed tolerances'
 WhichLead=1
 call FindChargeOnset(Tail,-100d0,-1000d0,100d0,ChargeAcc,FermiAcc,lo,hi,q,err,calls,status)
 if(status/=0.or.abs(q)>=ChargeAcc.or.hi-lo>FermiAcc) stop 14
 if(calls>100) stop 15
 print *, 'PASS: exponential tail bracketing and refinement, calls=',calls
 call FindChargeOnset(Plateau,-10d0,-100d0,100d0,ChargeAcc,FermiAcc,lo,hi,q,err,calls,status)
 if(status/=0.or.lo>=-2d0.or.-2d0-lo>FermiAcc) stop 16
 call FindChargeOnset(Bad,0d0,-100d0,100d0,ChargeAcc,FermiAcc,lo,hi,q,err,calls,status)
 if(status/=2) stop 17
 call FindChargeOnset(Tail,0d0,-100d0,100d0,-1d0,FermiAcc,lo,hi,q,err,calls,status)
 if(status/=1.or.calls/=0) stop 18
 call FindChargeOnset(Zero,0d0,-100d0,100d0,ChargeAcc,FermiAcc,lo,hi,q,err,calls,status)
 if(status/=3) stop 19
 call FindChargeOnset(Hole,-10d0,-100d0,100d0,ChargeAcc,FermiAcc,lo,hi,q,err,calls,status)
 if(status/=0.or.lo>=-2d0.or.-2d0-lo>FermiAcc) stop 25
 print *, 'PASS: unresolved interior points are skipped without classifying them as zero'
 print *, 'PASS: flat plateau, failed/nonfinite integral, invalid inputs and missing threshold'
 contains
 subroutine Tail(e,accuracy,q,error,info)
 real*8,intent(in)::e,accuracy
 real*8,intent(out)::q,error
 integer,intent(out)::info
 q=exp(e);error=accuracy/2d0;info=0
 end subroutine
 subroutine Plateau(e,accuracy,q,error,info)
 real*8,intent(in)::e,accuracy
 real*8,intent(out)::q,error
 integer,intent(out)::info
 q=0d0;if(e>=-2d0)q=1d0
 error=0d0;info=0
 end subroutine
 subroutine Bad(e,accuracy,q,error,info)
 real*8,intent(in)::e,accuracy
 real*8,intent(out)::q,error
 integer,intent(out)::info
 q=ieee_value(0d0,ieee_quiet_nan);error=0d0;info=0
 end subroutine
 subroutine Hole(e,accuracy,q,error,info)
 real*8,intent(in)::e,accuracy
 real*8,intent(out)::q,error
 integer,intent(out)::info
 call Plateau(e,accuracy,q,error,info)
 if(abs(e+3d0)<1d-10) info=2
 end subroutine
 subroutine Zero(e,accuracy,q,error,info)
 real*8,intent(in)::e,accuracy
 real*8,intent(out)::q,error
 integer,intent(out)::info
 q=0d0;error=0d0;info=0
 end subroutine
end program
