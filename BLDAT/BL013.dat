! ***************************
! Al Bethe Lattice parameters
! ***************************
!
! *********************************************************
! *** Papacon: orthogonal and non-orthogonal book fits  ***
! *********************************************************
!
BEGINSET
Papacon
4 1 3 0
s
p
RYD
! Papaconstantopoulos, Handbook of the Band Structure of Elemental Solids, 2nd ed.
! (Springer, 2015), Al fcc, a = 7.60 bohr, Slater-Koster 2-center parameters,
! first neighbours only: Table 7.10. The book fit is spd; only its s and p terms
! are kept, for the minimal sp basis. d and second-neighbour parameters omitted.
! Orthogonal fit.
ISPIN = 1
!
! On-site energies in Ryd
!
es  =   0.48220
ep  =   1.04964
!
! Hoppings in Ryd
!
sss =  -0.05831
sps =  -0.09315
pps =   0.17149
ppp =  -0.01020
ENDSET
!
BEGINSET
Papacon-nonortho
4 1 3 0
s
p
RYD
! Papaconstantopoulos, Handbook of the Band Structure of Elemental Solids, 2nd ed.
! (Springer, 2015), Al fcc, a = 7.60 bohr, Slater-Koster 2-center parameters,
! first neighbours only: Table 7.10. The book fit is spd; only its s and p terms
! are kept, for the minimal sp basis. d and second-neighbour parameters omitted.
! Non-orthogonal fit with overlaps. ANT uses the overlaps only with OVERLAP > 0
! (OVERLAP = 1 for the book values).
ISPIN = 1
!
! On-site energies in Ryd
!
es  =   0.20639
ep  =   0.58673
!
! Hoppings in Ryd
!
sss =  -0.05137
sps =   0.02672
pps =  -0.06630
ppp =  -0.02184
!
! Overlap parameters
!
S_sss =   0.11591
S_sps =  -0.19400
S_pps =  -0.31915
S_ppp =   0.05724
ENDSET
!
! *******************************************************************************
! *** Old Papacon TB parameters for valence minimal basis set without overlap ***
! *******************************************************************************
!
BEGINSET
Papacon-old
4 1 3 0
s
p
RYD
ISPIN = 1
!
! Energies in Ryd 
!
es = 0.35512
ep = 0.88653
!
! Hoppings in Ryd
!
sss = -0.04852
sps = -0.08296
pps = 0.19317
ppp = 0.06339
ENDSET
!
! ***********************************************************
! *** TB parameters from al-fcc.lsda.crenbs.out ***
! ***********************************************************
!
BEGINSET
lsda-crenbs
4 1 3 0
s
p
ISPIN = 1
!
! Hoppings
!
es  =  -3.0320E-01 
ep  =  -1.7080E-01 
!
sss =  -9.9306E-02 
sps =   1.2923E-01 
pps =   9.8715E-02 
ppp =  -6.6623E-02 
!
! Overlap parameters
!
S_sss =  2.0741E-01 
S_sps = -3.3708E-01 
S_pps = -3.7204E-01 
S_ppp =  1.8042E-01 
ENDSET
