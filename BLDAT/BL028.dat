! ***************************
! Ni Bethe Lattice parameters
! ***************************
!
! *********************************************************
! *** Papacon: orthogonal and non-orthogonal book fits  ***
! *********************************************************
!
BEGINSET
Papacon
9 2 10 0
s
p
d
RYD
! Papaconstantopoulos, Handbook of the Band Structure of Elemental Solids, 2nd ed.
! (Springer, 2015), Ni fcc ferromagnetic, a = 6.65845 bohr, Slater-Koster 2-center
! parameters, first neighbours only: Table 4.73 (spin up) and Table 4.78 (spin down).
! Book on-site d1 = t2g (edt) and d2 = eg (edd). Second-neighbour parameters omitted.
! Orthogonal fit.
ISPIN = 1
!
! On-site energies in Ryd
!
es  =   0.99144
ep  =   1.52711
edd =   0.48665
edt =   0.48464
!
! Hoppings in Ryd
!
sss =  -0.08657
sps =   0.13148
pps =   0.21620
ppp =   0.00965
sds =  -0.03056
pds =  -0.03015
pdp =   0.02725
dds =  -0.03441
ddp =   0.02534
ddd =  -0.00597
ISPIN = 2
!
! On-site energies in Ryd
!
es  =   0.98738
ep  =   1.50091
edd =   0.53843
edt =   0.54152
!
! Hoppings in Ryd
!
sss =  -0.08649
sps =   0.12589
pps =   0.20673
ppp =   0.01310
sds =  -0.03632
pds =  -0.03814
pdp =   0.02894
dds =  -0.03579
ddp =   0.02590
ddd =  -0.00633
ENDSET
!
BEGINSET
Papacon-nonortho
9 2 10 0
s
p
d
RYD
! Papaconstantopoulos, Handbook of the Band Structure of Elemental Solids, 2nd ed.
! (Springer, 2015), Ni fcc ferromagnetic, a = 6.65845 bohr, Slater-Koster 2-center
! parameters, first neighbours only: Table 4.73 (spin up) and Table 4.78 (spin down).
! Book on-site d1 = t2g (edt) and d2 = eg (edd). Second-neighbour parameters omitted.
! Non-orthogonal fit with overlaps.
ISPIN = 1
!
! On-site energies in Ryd
!
es  =   0.56544
ep  =   1.00232
edd =   0.48830
edt =   0.48837
!
! Hoppings in Ryd
!
sss =  -0.04783
sps =  -0.00561
pps =  -0.19160
ppp =  -0.02827
sds =  -0.02904
pds =  -0.01053
pdp =   0.01666
dds =  -0.02037
ddp =   0.01359
ddd =  -0.00180
ISPIN = 2
!
! On-site energies in Ryd
!
es  =   0.57809
ep  =   1.01983
edd =   0.54070
edt =   0.54087
!
! Hoppings in Ryd
!
sss =  -0.04486
sps =  -0.00981
pps =  -0.19683
ppp =  -0.02104
sds =  -0.02878
pds =  -0.00807
pdp =   0.01402
dds =  -0.02026
ddp =   0.01214
ddd =  -0.00073
!
! Overlap parameters (spin average of the book values; ANT uses one set for both spins)
!
S_sss =   0.131595
S_sps =  -0.208150
S_pps =  -0.345195
S_ppp =   0.060055
S_sds =   0.039960
S_pds =   0.073555
S_pdp =  -0.037045
S_dds =   0.028045
S_ddp =  -0.019155
S_ddd =   0.003745
ENDSET
!
! ************************************************
! *** Papacon-sd non-orthogonal TB parameters  ***
! ************************************************
!
BEGINSET
Papacon-sd
6 2 10 0
s
d
RYD
ISPIN =            1
!
! On-site enrgies in Ryd
!
es =    0.1056093448686473     
edd =   -12.4333420050839312E-002
edt =   -12.4333420050839312E-002
!
! Hoppings in Ryd
!
sss =   -0.1030332419052912     
sds =   -3.7607911533326481E-002
pds =    5.5496810342579250E-002
pdp =   -2.3485409083813549E-002
dds =   -3.4820425342845902E-002
ddp =    2.5599190083128160E-002
ddd =   -5.6870005292460890E-003
ISPIN =            2
!
! On-site enrgies in Ryd
!
es =    0.1350694887335478     
edd =   -1.9697235493986081E-002
edt =   -1.9697235493986081E-002
!
! Hoppings in Ryd
!
sss =   -0.1030332419052912     
sds =   -3.7607911533326481E-002
pds =    5.5496810342579250E-002
pdp =   -2.3485409083813549E-002
dds =   -3.4820425342845902E-002
ddp =    2.5599190083128160E-002
ddd =   -5.6870005292460890E-003
! 
! Overlap parameters
! 
S_sss =    0.1817704879067281     
S_sds =    8.1324419773221734E-004
S_pds =    2.9995797509112254E-002
S_pdp =    9.9776143600185812E-003
S_dds =    2.4512922333620475E-003
S_ddp =   -2.2269541560923778E-002
S_ddd =    6.7977240753691373E-003
ENDSET

 BEGINSET
 FCC-sd
6 2 10 0
s
d
 RYD
 ! Fitted on a 12-direction (fcc) Bethe lattice to the CRYSTAL23 LSDA DOS of
 ! ferromagnetic fcc Ni, a = 3.524 A, with the CRENBS sd basis + ECP (s and d
 ! projected DOS of both spins and the 0.70 muB moment). No overlaps.
 ISPIN =            1
 !
 ! On-site enrgies in Ryd
 !
 es  = -1.9888814821426425E-02
 edd = 1.0151693417063620E-01
 edt = 7.3404623842398292E-02
 !
 ! Hoppings in Ryd
 !
 sss = -1.0877552398355383E-01
 sds = -6.2707630366708206E-02
 dds = -4.0729932348325268E-02
 ddp = 9.6362040904571997E-03
 ddd = -6.8258522972442703E-03
 ISPIN =            2
 !
 ! On-site enrgies in Ryd
 !
 es  = 1.2108344851112483E-01
 edd = 1.8562750163180805E-01
 edt = 1.6324082472986295E-01
 !
 ! Hoppings in Ryd
 !
 sss = -1.0877552398355383E-01
 sds = -6.2707630366708206E-02
 dds = -4.0729932348325268E-02
 ddp = 9.6362040904571997E-03
 ddd = -6.8258522972442703E-03
 ENDSET

 BEGINSET
 FCC-spd
9 2 10 0
s
p
d
 RYD
 ! Fitted on a 12-direction (fcc) Bethe lattice to the CRYSTAL23 LSDA DOS of
 ! ferromagnetic fcc Ni, a = 3.524 A, with the CRENBS s+d basis + ECP plus the
 ! STO-3G 4p shell scaled by 0.60 (s, d and total DOS of both spins and the
 ! 0.53 muB moment; p DOS not fitted). No overlaps.
 ISPIN =            1
 !
 ! On-site enrgies in Ryd
 !
 es  = 4.0318955361538100E-01
 ep  = 1.4089473732025051E+00
 edd = 1.0151693417063620E-01
 edt = 7.4580392307555754E-02
 !
 ! Hoppings in Ryd
 !
 sss = -1.0905674294100787E-01
 sps = 1.0639022372229331E-01
 pps = 1.4126480977640996E-01
 ppp = -1.0211685590030274E-02
 sds = -3.5151455245158385E-02
 pds = -1.5016135607129572E-01
 pdp = 7.1076064033751565E-02
 dds = -2.7041248230230776E-02
 ddp = 3.6762978647747078E-03
 ddd = -9.2555759282997297E-04
 ISPIN =            2
 !
 ! On-site enrgies in Ryd
 !
 es  = 4.1558931640269309E-01
 ep  = 1.3372336387363430E+00
 edd = 1.8874696080059047E-01
 edt = 1.5181323398164390E-01
 !
 ! Hoppings in Ryd
 !
 sss = -1.0905674294100787E-01
 sps = 1.0639022372229331E-01
 pps = 1.4126480977640996E-01
 ppp = -1.0211685590030274E-02
 sds = -3.5151455245158385E-02
 pds = -1.5016135607129572E-01
 pdp = 7.1076064033751565E-02
 dds = -2.7041248230230776E-02
 ddp = 3.6762978647747078E-03
 ddd = -9.2555759282997297E-04
 ENDSET
